    {
      "parameters": {
        "jsCode": "const allSlots = ['09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00'];\nconst booked = $input.all().map(i => i.json.appointment_time);\nconst free = allSlots.filter(t => !booked.includes(t));\nconst chips = free.map(t => '<span style=\"display:inline-block;margin:4px;padding:8px 14px;border-radius:20px;background:#e8f0fe;color:#1a3c7a;font-weight:600\">' + t + '</span>').join('');\nreturn [{ json: { free_slots: free.length ? free.join(', ') : 'none left, please pick another date', chips: chips || 'No free times left on this date.' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
