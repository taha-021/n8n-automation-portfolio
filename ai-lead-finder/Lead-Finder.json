    {
      "parameters": {
        "jsCode": "const newLeads = $('Search Google Maps').all().map(i => i.json);\nconst existing = $input.all().map(i => i.json);\n\nconst norm = u => (u || '').toLowerCase().trim().replace(/\\/$/, '').replace(/^https?:\\/\\//, '').replace(/^www\\./, '');\n\nconst seenInSheet = new Set(existing.map(l => norm(l.Website)));\nconst seenInBatch = new Set();\n\nreturn newLeads\n  .filter(l => {\n    const url = norm(l.website);\n    if (!url) return false;\n    if (seenInSheet.has(url)) return false;\n    if (seenInBatch.has(url)) return false;\n    seenInBatch.add(url);\n    return true;\n  })\n  .map(l => ({ json: l }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
