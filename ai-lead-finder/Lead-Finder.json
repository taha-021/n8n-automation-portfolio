        "messages": {
          "values": [
            {
              "content": "=You score local business leads for a digital agency. Score 1-10 (10 = best lead).\n\nSignals:\n- No email found on website → +3\n- Reviews < 50 → +2\n- Rating < 4.5 → +2\n- Reviews > 300 → -2\n- Has email found → -1\n\nBusiness: {{ $json.title }}\nRating: {{ $json.rating }} ({{ $json.reviews }} reviews)\nEmail found: {{ $json.email_found }}\n\nCRITICAL: Reply in EXACTLY this format. No thinking. No explanation. No math shown.\nscore|reason\n\nExample valid reply: 8|No email found and low review count makes them accessible."
            }
